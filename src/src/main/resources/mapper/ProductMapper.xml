<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.seckill_backend.mapper.ProductMapper">
    <insert id="createProduct" keyProperty="product_id" useGeneratedKeys="true">
        INSERT INTO product(name, price, stock, status)
        VALUES (#{name}, #{price}, #{stock}, #{status})
    </insert>
    <select id="getProduct" resultType="com.example.seckill_backend.model.Product">
        SELECT * FROM product
        <where>
            <if test="product_id != null" >
                product_id = #{product_id}
            </if>
            <if test="name != null" >
                AND name = #{name}
            </if>
            <if test="status != null" >
                AND status = #{status}
            </if>
        </where>
        limit #{page_size} offset #{offset}
    </select>
    <select id="getProductById" resultType="com.example.seckill_backend.model.Product">
        SELECT * FROM product
        <where>
            <if test="product_id != null" >
                product_id = #{product_id}
            </if>
        </where>
    </select>
    <update id="updateProduct" >
        UPDATE product
        <set>
            <if test="name != null" >
                name = #{name},
            </if>
            <if test="price != null" >
                price = #{price},
            </if>
            <if test="stock != null" >
                stock = #{stock},
            </if>
            <if test="status != null" >
                status = #{status},
            </if>
        </set>
        WHERE product_id = #{product_id}
    </update>
    <delete id="deleteProduct">
        DELETE FROM product WHERE product_id = #{product_id}
    </delete>
</mapper>